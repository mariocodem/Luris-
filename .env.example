# Copia este archivo como .env y ajusta los valores.
# Todas las variables se validan con Zod al arrancar (src/shared/infrastructure/env.ts).

# Entorno: development | test | production
NODE_ENV=development

# URL pública de la aplicación (se usa en enlaces de correos y notificaciones).
APP_URL=http://localhost:3000

# PostgreSQL. En desarrollo: `pnpm db:up` levanta la base con docker-compose.dev.yml.
DATABASE_URL=postgresql://luris:luris@localhost:5432/luris
# Si el puerto 5432 ya lo usa otro PostgreSQL, publica el de LURIS en otro puerto (docker compose
# lee esta variable) y ajusta el puerto de DATABASE_URL.
# POSTGRES_PORT=5433

# Pruebas de integración (opcional). Si se omite, se usa DATABASE_URL con el sufijo "_test"
# (p. ej. luris_test). Esa base se BORRA y se recrea en cada ejecución de `pnpm test`.
# TEST_DATABASE_URL=postgresql://luris:luris@localhost:5432/luris_test
# Pruebas e2e (opcional). Si se omite, DATABASE_URL con el sufijo "_e2e"; también se BORRA y se
# recrea (con la semilla) en cada ejecución de `pnpm test:e2e`.
# E2E_DATABASE_URL=postgresql://luris:luris@localhost:5432/luris_e2e

# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Formato: json (producción) | pretty (legible en desarrollo). Si se omite: pretty en desarrollo, json en el resto.
LOG_FORMAT=pretty

# Autenticación (Better Auth): firma las cookies de sesión. Obligatorio, mínimo 32 caracteres.
# Genera uno con: openssl rand -base64 32   (o: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=

# Vigencia del enlace de invitación (horas) y del enlace de recuperación de contraseña (minutos).
# INVITACION_HORAS_VIGENCIA=72
# RECUPERACION_MINUTOS_VIGENCIA=60

# Correos (de cuenta y avisos de actuaciones). "archivo" (solo desarrollo) guarda cada correo como
# .html en CORREO_DIRECTORIO para abrirlo en el navegador. En producción es obligatorio "smtp".
# CORREO_TRANSPORTE=archivo
# CORREO_DIRECTORIO=.correos
# CORREO_REMITENTE="LURIS <no-responder@luris.test>"
# SMTP (con CORREO_TRANSPORTE=smtp). Puerto 587 negocia STARTTLS; 465 usa TLS implícito.
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PUERTO=587
# SMTP_SEGURO=false
# SMTP_USUARIO=
# SMTP_CLAVE=

# ─── Notificaciones (Fase 11) ─────────────────────────────────────────────────
# Hora (0-23, Bogotá) del resumen diario de actuaciones nuevas.
# NOTIFICACIONES_HORA_RESUMEN=7
# Mensajes de WhatsApp por minuto y por despacho. Bajo a propósito (la librería no es la API
# oficial de Meta). La sesión de WhatsApp se guarda cifrada con CREDENCIALES_CLAVE.
# WHATSAPP_MENSAJES_POR_MINUTO=6

# ─── Plataformas judiciales (Fase 5) ──────────────────────────────────────────
# API de la Consulta de Procesos Nacional Unificada (Rama Judicial).
# CPNU_URL_BASE=https://consultaprocesos.ramajudicial.gov.co:448/api/v2
# Ritmo conservador: con ~35 solicitudes/minuto la CPNU respondió 403 (ver docs/plataformas/rama-cpnu.md).
# CPNU_SOLICITUDES_POR_MINUTO=20
# CPNU_CONCURRENCIA=2
# Minutos sin consultar la CPNU cuando frena a LURIS (403 o 429 persistente).
# CPNU_PAUSA_POR_BLOQUEO_MINUTOS=10
# PLATAFORMAS_TIEMPO_LIMITE_SEGUNDOS=60
# PLATAFORMAS_REINTENTOS=2
# User-Agent identificable de LURIS. Si se omite: "LURIS/0.1 (seguimiento de procesos judiciales; +APP_URL)".
# PLATAFORMAS_USER_AGENT=
# Sincronización de todos los procesos activos: cron de 5 campos en hora de Bogotá, u "off".
# SINCRONIZACION_CRON="0 6,13,19 * * *"

# ─── SPOA de la Fiscalía (Fase 6) ─────────────────────────────────────────────
# Portal «Consulta su denuncia» que se muestra en la consulta asistida (la persona resuelve el reto).
# SPOA_URL_PORTAL=https://consulta-web.fiscalia.gov.co/
# Días sin consultar el SPOA tras los cuales el proceso vuelve a la bandeja de pendientes.
# SPOA_DIAS_ENTRE_CONFIRMACIONES=7
# Servicio oficial de interoperabilidad: SOLO cuando la Fiscalía conceda el acceso
# (docs/solicitudes/fiscalia-spoa-interoperabilidad.md). Con ambos valores, el SPOA se consulta solo.
# SPOA_INTEROPERABILIDAD_URL=
# SPOA_INTEROPERABILIDAD_TOKEN=
# SPOA_SOLICITUDES_POR_MINUTO=10

# ─── SAMAI y credenciales (Fase 7) ────────────────────────────────────────────
# SAMAI_URL_BASE=https://samai.consejodeestado.gov.co
# SAMAI_SOLICITUDES_POR_MINUTO=10
# Clave AES-256-GCM (32 bytes en base64) para cifrar las contraseñas de plataformas que registran los
# abogados. Sin ella, LURIS no acepta credenciales. Genera una con: openssl rand -base64 32
# Guárdala bien: si se pierde, hay que registrar de nuevo todas las credenciales.
CREDENCIALES_CLAVE=

# ─── SIUGJ (Fase 8) ──────────────────────────────────────────────────────────
# Portal de SIUGJ. LURIS lo consulta con la cuenta de usuario externo que registra el abogado
# (o el despacho) en Ajustes → Plataformas, con un navegador automatizado (Playwright).
# SIUGJ_URL_BASE=https://siugj.ramajudicial.gov.co
# Navegador del worker: chromium (Docker; instálalo con `pnpm exec playwright install chromium`),
# o el del equipo en desarrollo: msedge | chrome.
# SIUGJ_NAVEGADOR=chromium
# SIUGJ_SOLICITUDES_POR_MINUTO=6
# Minutos que LURIS espera el código de acceso (segundo factor) que SIUGJ envía a la persona.
# SIUGJ_MINUTOS_PARA_CODIGO=10

# ─── Documentos (Fase 5) ──────────────────────────────────────────────────────
# Carpeta de los documentos descargados (en Docker, el volumen de la app). La usan la web y el worker.
# ALMACEN_DIRECTORIO=storage/documentos
# DOCUMENTO_TAMANO_MAXIMO_MB=25
