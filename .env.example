# Copia este archivo como .env y ajusta los valores.
# Todas las variables se validan con Zod al arrancar (src/shared/infrastructure/env.ts).

# Entorno: development | test | production
NODE_ENV=development

# URL pública de la aplicación (se usa en enlaces de correos y notificaciones).
APP_URL=http://localhost:3000

# PostgreSQL. En desarrollo: `pnpm db:up` levanta la base con docker-compose.dev.yml.
DATABASE_URL=postgresql://luris:luris@localhost:5432/luris

# Pruebas de integración (opcional). Si se omite, se usa DATABASE_URL con el sufijo "_test"
# (p. ej. luris_test). Esa base se BORRA y se recrea en cada ejecución de `pnpm test`.
# TEST_DATABASE_URL=postgresql://luris:luris@localhost:5432/luris_test

# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Formato: json (producción) | pretty (legible en desarrollo). Si se omite: pretty en desarrollo, json en el resto.
LOG_FORMAT=pretty
