// LURIS — modelo de datos (ver §4 de CLAUDE.md).
//
// Convenciones:
// - Modelos y campos en español (camelCase); tablas y columnas en snake_case.
// - IDs UUID v7 (ordenables en el tiempo).
// - Instantes en timestamptz. Las fechas oficiales de las plataformas son `date` (día calendario):
//   se guardan tal cual las informa la plataforma, sin conversión de zona horaria.
// - Multi-despacho: toda tabla de negocio tiene `despachoId`. Las tablas hijas referencian a su
//   padre con una clave foránea compuesta (padreId, despachoId), así la base de datos impide que
//   un registro apunte a datos de otro despacho. Ver src/shared/infrastructure/prisma.
// - Restricciones CHECK (formato de radicado, roles, consentimientos…) en la migración inicial.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enumeraciones ────────────────────────────────────────────────────────────

enum EstadoDespacho {
  ACTIVO
  SUSPENDIDO

  @@map("estado_despacho")
}

enum CodigoPlataforma {
  RAMA_CPNU
  SPOA
  SAMAI
  SIUGJ
  TYBA

  @@map("codigo_plataforma")
}

enum TipoIdentificador {
  RADICADO
  NUNC

  @@map("tipo_identificador")
}

/// Resultado de la última consulta a una plataforma (mismos códigos que ErrorPlataforma).
enum EstadoConsulta {
  EXITOSA
  NO_ENCONTRADO
  PLATAFORMA_NO_DISPONIBLE
  CREDENCIALES_INVALIDAS
  REQUIERE_INTERVENCION
  LIMITE_DE_CONSULTAS
  RESPUESTA_INESPERADA
  /// La cuenta entra a la plataforma pero no tiene acceso a ese expediente (SIUGJ).
  SIN_ACCESO
  /// La plataforma exige una cuenta y no hay ninguna registrada para el proceso.
  SIN_CREDENCIAL

  @@map("estado_consulta")
}

enum TipoAsignacion {
  /// Abogado responsable del proceso (máximo uno por proceso).
  RESPONSABLE
  /// Persona asignada para apoyar el seguimiento (p. ej. un asistente).
  ASIGNADO

  @@map("tipo_asignacion")
}

enum AlcanceCredencial {
  /// Credencial del despacho, la registra un administrador.
  DESPACHO
  /// Credencial personal de un abogado.
  PERSONAL

  @@map("alcance_credencial")
}

enum EstadoDocumento {
  PENDIENTE
  DESCARGADO
  NO_DISPONIBLE

  @@map("estado_documento")
}

enum EstadoConsultaMasiva {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA

  @@map("estado_consulta_masiva")
}

enum EstadoItemConsultaMasiva {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
  FALLIDO
  /// Plataforma con consulta asistida: espera que el usuario resuelva el reto (§6).
  PENDIENTE_CONFIRMACION

  @@map("estado_item_consulta_masiva")
}

/// Por qué hay que confirmar una consulta asistida (§6).
enum OrigenPendiente {
  /// La sincronización periódica: el proceso lleva días sin consultarse en esa plataforma.
  PROGRAMADA
  /// Un ítem de una consulta masiva (Fase 10).
  MASIVA

  @@map("origen_pendiente")
}

enum CanalNotificacion {
  CORREO
  WHATSAPP

  @@map("canal_notificacion")
}

enum FrecuenciaNotificacion {
  INMEDIATA
  RESUMEN_DIARIO

  @@map("frecuencia_notificacion")
}

/// Estado de la sesión de WhatsApp de un despacho (Fase 11, §9).
enum EstadoSesionWhatsapp {
  SIN_VINCULAR
  /// Esperando que se escanee el QR.
  VINCULANDO
  CONECTADA
  /// Vinculada, pero sin conexión ahora (se reconecta sola).
  DESCONECTADA

  @@map("estado_sesion_whatsapp")
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  FALLIDA

  @@map("estado_notificacion")
}

// ─── Despachos, usuarios y membresías ─────────────────────────────────────────
// Compatibles con Better Auth (Fase 2): Despacho = organization, Membresia = member.

/// Tenant: un despacho jurídico o abogado independiente.
model Despacho {
  id            String         @id @default(uuid(7)) @db.Uuid
  nombre        String         @db.VarChar(200)
  slug          String         @unique @db.VarChar(100)
  /// Solo dígitos (incluye el dígito de verificación).
  nit           String?        @unique @db.VarChar(15)
  plan          String         @default("ESTANDAR") @db.VarChar(50)
  estado        EstadoDespacho @default(ACTIVO)
  logo          String?
  metadata      String?
  creadoEn      DateTime       @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime       @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  membresias         Membresia[]
  invitaciones       Invitacion[]
  sesionesActivas    Sesion[]
  procesos           Proceso[]
  etiquetas          Etiqueta[]
  registrosAuditoria RegistroAuditoria[]
  pendientes         PendienteDeConfirmacion[]
  sesionWhatsapp     SesionWhatsapp?

  @@map("despachos")
}

/// Persona con cuenta en LURIS. Es global: puede pertenecer a varios despachos.
model Usuario {
  id              String   @id @default(uuid(7)) @db.Uuid
  nombre          String   @db.VarChar(200)
  /// Siempre en minúsculas (restricción CHECK).
  email           String   @unique @db.VarChar(320)
  emailVerificado Boolean  @default(false) @map("email_verificado")
  imagen          String?
  /// Operador de LURIS: administra despachos, no ve datos de procesos.
  esSuperadmin    Boolean  @default(false) @map("es_superadmin")
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn   DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  membresias           Membresia[]
  sesiones             Sesion[]
  cuentas              Cuenta[]
  invitacionesEnviadas Invitacion[]
  registrosAuditoria   RegistroAuditoria[]

  @@map("usuarios")
}

// ─── Autenticación (Better Auth) ──────────────────────────────────────────────
// Tablas propias de la autenticación: no son datos de negocio y el cliente de un despacho no
// puede leerlas ni escribirlas. Los nombres de modelo y campo se mapean en la configuración de
// Better Auth (src/modules/usuarios/infrastructure/autenticacion).

/// Sesión iniciada en un navegador. El token es opaco; Better Auth lo firma en la cookie.
model Sesion {
  id               String   @id @default(uuid(7)) @db.Uuid
  token            String   @unique @db.VarChar(255)
  expiraEn         DateTime @map("expira_en") @db.Timestamptz(3)
  direccionIp      String?  @map("direccion_ip") @db.VarChar(45)
  agenteDeUsuario  String?  @map("agente_de_usuario") @db.VarChar(1000)
  usuarioId        String   @map("usuario_id") @db.Uuid
  /// Despacho en el que trabaja la sesión (organización activa de Better Auth).
  despachoActivoId String?  @map("despacho_activo_id") @db.Uuid
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  despachoActivo Despacho? @relation(fields: [despachoActivoId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([despachoActivoId])
  @@map("sesiones")
}

/// Forma de autenticarse de un usuario. En LURIS solo existe la de correo y contraseña
/// (proveedor "credential"); la contraseña se guarda con hash (scrypt), nunca en claro.
model Cuenta {
  id                 String    @id @default(uuid(7)) @db.Uuid
  idEnProveedor      String    @map("id_en_proveedor") @db.VarChar(255)
  proveedor          String    @db.VarChar(50)
  usuarioId          String    @map("usuario_id") @db.Uuid
  tokenDeAcceso      String?   @map("token_de_acceso")
  tokenDeRenovacion  String?   @map("token_de_renovacion")
  tokenDeIdentidad   String?   @map("token_de_identidad")
  accesoExpiraEn     DateTime? @map("acceso_expira_en") @db.Timestamptz(3)
  renovacionExpiraEn DateTime? @map("renovacion_expira_en") @db.Timestamptz(3)
  alcance            String?
  contrasenaHash     String?   @map("contrasena_hash")
  creadoEn           DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn      DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([proveedor, idEnProveedor])
  @@index([usuarioId])
  @@map("cuentas")
}

/// Valores de un solo uso de Better Auth (p. ej. el token de recuperación de contraseña).
model Verificacion {
  id            String   @id @default(uuid(7)) @db.Uuid
  identificador String   @db.VarChar(255)
  valor         String
  expiraEn      DateTime @map("expira_en") @db.Timestamptz(3)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@index([identificador])
  @@map("verificaciones")
}

/// Invitación a un despacho (§5): enlace de un solo uso con vencimiento.
/// Compatible con la tabla "invitation" del plugin de organizaciones de Better Auth.
model Invitacion {
  id            String    @id @default(uuid(7)) @db.Uuid
  despachoId    String    @map("despacho_id") @db.Uuid
  /// Siempre en minúsculas (restricción CHECK).
  email         String    @db.VarChar(320)
  /// administrador | abogado | asistente (restricción CHECK).
  rol           String    @db.VarChar(20)
  /// pending | accepted | canceled | rejected (valores de Better Auth, restricción CHECK).
  estado        String    @default("pending") @db.VarChar(20)
  expiraEn      DateTime  @map("expira_en") @db.Timestamptz(3)
  invitadoPorId String    @map("invitado_por_id") @db.Uuid
  /// SHA-256 del token del enlace. El token en claro solo viaja en el correo.
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  aceptadaEn    DateTime? @map("aceptada_en") @db.Timestamptz(3)
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  despacho    Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  invitadoPor Usuario  @relation(fields: [invitadoPorId], references: [id], onDelete: Cascade)

  @@unique([id, despachoId])
  /// Una sola invitación pendiente por persona y despacho (reenviar reemplaza la anterior).
  @@unique([despachoId, email], map: "invitaciones_pendiente_unica", where: raw("(estado)::text = 'pending'::text"))
  @@index([despachoId, estado])
  @@index([email])
  @@map("invitaciones")
}

/// Pertenencia de un usuario a un despacho, con su rol.
model Membresia {
  id            String   @id @default(uuid(7)) @db.Uuid
  despachoId    String   @map("despacho_id") @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  /// administrador | abogado | asistente (restricción CHECK). Texto, no enum, por compatibilidad con Better Auth.
  rol           String   @db.VarChar(20)
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  despacho Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  asignaciones            AsignacionProceso[]
  credenciales            CredencialPlataforma[]
  consultasMasivas        ConsultaMasiva[]
  preferenciaNotificacion PreferenciaNotificacion?
  notificaciones          Notificacion[]
  documentosSubidos       Documento[]

  @@unique([despachoId, usuarioId])
  @@unique([id, despachoId])
  @@index([usuarioId])
  @@map("membresias")
}

// ─── Procesos ─────────────────────────────────────────────────────────────────

model Proceso {
  id            String   @id @default(uuid(7)) @db.Uuid
  despachoId    String   @map("despacho_id") @db.Uuid
  /// 23 dígitos, sin guiones ni espacios. Texto para conservar los ceros a la izquierda.
  radicado      String?  @db.VarChar(23)
  /// 21 dígitos (SPOA). Al menos uno de radicado o nunc es obligatorio (CHECK).
  nunc          String?  @db.VarChar(21)
  alias         String?  @db.VarChar(200)
  /// Cliente o parte, texto libre.
  cliente       String?  @db.VarChar(300)
  /// Alias y cliente en minúsculas y sin tildes, para buscar sin importar cómo se escriban
  /// («Perez» encuentra «Pérez»). Lo mantiene el repositorio de procesos.
  busqueda      String   @default("") @db.VarChar(510)
  /// false = archivado.
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  despacho Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)

  asignaciones          AsignacionProceso[]
  etiquetas             EtiquetaProceso[]
  plataformas           ProcesoPlataforma[]
  pendientes            PendienteDeConfirmacion[]
  itemsDeConsultaMasiva ItemConsultaMasiva[]

  @@unique([despachoId, radicado])
  @@unique([despachoId, nunc])
  @@unique([id, despachoId])
  @@index([despachoId, activo])
  @@map("procesos")
}

/// Quién sigue cada proceso: el abogado responsable y las personas asignadas.
model AsignacionProceso {
  id          String         @id @default(uuid(7)) @db.Uuid
  despachoId  String         @map("despacho_id") @db.Uuid
  procesoId   String         @map("proceso_id") @db.Uuid
  membresiaId String         @map("membresia_id") @db.Uuid
  tipo        TipoAsignacion
  creadoEn    DateTime       @default(now()) @map("creado_en") @db.Timestamptz(3)

  proceso   Proceso   @relation(fields: [procesoId, despachoId], references: [id, despachoId], onDelete: Cascade)
  membresia Membresia @relation(fields: [membresiaId, despachoId], references: [id, despachoId], onDelete: Cascade)

  @@unique([procesoId, membresiaId])
  @@unique([procesoId], map: "asignaciones_proceso_un_responsable", where: raw("tipo = 'RESPONSABLE'"))
  @@index([membresiaId, tipo])
  @@map("asignaciones_proceso")
}

model Etiqueta {
  id         String   @id @default(uuid(7)) @db.Uuid
  despachoId String   @map("despacho_id") @db.Uuid
  nombre     String   @db.VarChar(50)
  color      String?  @db.VarChar(20)
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  despacho Despacho          @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  procesos EtiquetaProceso[]

  @@unique([despachoId, nombre])
  @@unique([id, despachoId])
  @@map("etiquetas")
}

model EtiquetaProceso {
  despachoId String   @map("despacho_id") @db.Uuid
  procesoId  String   @map("proceso_id") @db.Uuid
  etiquetaId String   @map("etiqueta_id") @db.Uuid
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  proceso  Proceso  @relation(fields: [procesoId, despachoId], references: [id, despachoId], onDelete: Cascade)
  etiqueta Etiqueta @relation(fields: [etiquetaId, despachoId], references: [id, despachoId], onDelete: Cascade)

  @@id([procesoId, etiquetaId])
  @@index([etiquetaId])
  @@map("etiquetas_proceso")
}

// ─── Plataformas y actuaciones ────────────────────────────────────────────────

/// En qué plataformas existe el proceso y cómo fue su última consulta.
model ProcesoPlataforma {
  id                     String           @id @default(uuid(7)) @db.Uuid
  despachoId             String           @map("despacho_id") @db.Uuid
  procesoId              String           @map("proceso_id") @db.Uuid
  plataforma             CodigoPlataforma
  /// Identificador del proceso en la plataforma (p. ej. idProceso de la CPNU).
  idExterno              String?          @map("id_externo") @db.VarChar(100)
  /// Datos del proceso tal como los informa la plataforma (despacho judicial, partes, clase…).
  datosProceso           Json?            @map("datos_proceso")
  /// Última consulta exitosa (instante de LURIS, no es una fecha oficial).
  ultimaSincronizacionEn DateTime?        @map("ultima_sincronizacion_en") @db.Timestamptz(3)
  /// Último intento de consulta, exitoso o no.
  ultimaConsultaEn       DateTime?        @map("ultima_consulta_en") @db.Timestamptz(3)
  estadoUltimaConsulta   EstadoConsulta?  @map("estado_ultima_consulta")
  creadoEn               DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn          DateTime         @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  proceso     Proceso     @relation(fields: [procesoId, despachoId], references: [id, despachoId], onDelete: Cascade)
  actuaciones Actuacion[]

  @@unique([procesoId, plataforma])
  @@unique([id, despachoId])
  @@index([despachoId, plataforma])
  @@map("procesos_plataforma")
}

model Actuacion {
  id                  String            @id @default(uuid(7)) @db.Uuid
  despachoId          String            @map("despacho_id") @db.Uuid
  procesoPlataformaId String            @map("proceso_plataforma_id") @db.Uuid
  idExterno           String?           @map("id_externo") @db.VarChar(100)
  /// idExterno si la plataforma lo da; si no, un hash estable del contenido. Evita duplicados.
  claveDeduplicacion  String            @map("clave_deduplicacion") @db.VarChar(100)
  /// Fecha oficial de la actuación, según la plataforma.
  fechaActuacion      DateTime          @map("fecha_actuacion") @db.Date
  /// Fecha oficial en que la plataforma registró la actuación (nula si la plataforma no la informa).
  fechaRegistro       DateTime?         @map("fecha_registro") @db.Date
  descripcion         String
  anotacion           String?
  /// Despacho judicial (juzgado, tribunal…) que registró la actuación, según la plataforma.
  /// No confundir con `despachoId`, el despacho de abogados dueño del dato.
  despachoJudicial    String?           @map("despacho_judicial") @db.VarChar(200)
  /// Término que corre por la actuación (fechas oficiales), si la plataforma lo informa.
  terminoInicia       DateTime?         @map("termino_inicia") @db.Date
  terminoVence        DateTime?         @map("termino_vence") @db.Date
  tieneDocumentos     Boolean           @default(false) @map("tiene_documentos")
  /// Sistema de origen cuando la actuación llega por otra plataforma (TYBA por la CPNU); nulo si
  /// la plataforma de la consulta es también su origen.
  origen              CodigoPlataforma?
  /// true si llegó en la primera consulta del proceso en esa plataforma: es historia, no novedad,
  /// y no se notifica.
  cargaInicial        Boolean           @default(false) @map("carga_inicial")
  /// Cuándo la detectó LURIS. SOLO auditoría: nunca se muestra como fecha de la actuación.
  detectadaEn         DateTime          @default(now()) @map("detectada_en") @db.Timestamptz(3)

  procesoPlataforma ProcesoPlataforma @relation(fields: [procesoPlataformaId, despachoId], references: [id, despachoId], onDelete: Cascade)
  documentos        Documento[]
  notificaciones    Notificacion[]

  @@unique([procesoPlataformaId, claveDeduplicacion])
  @@unique([id, despachoId])
  @@index([procesoPlataformaId, fechaActuacion(sort: Desc)])
  @@index([despachoId, fechaActuacion(sort: Desc)])
  @@map("actuaciones")
}

model Documento {
  id                 String          @id @default(uuid(7)) @db.Uuid
  despachoId         String          @map("despacho_id") @db.Uuid
  actuacionId        String          @map("actuacion_id") @db.Uuid
  /// Identificador del documento en la plataforma (p. ej. idRegDocumento de la CPNU).
  idExterno          String?         @map("id_externo") @db.VarChar(100)
  nombre             String          @db.VarChar(300)
  /// Fecha oficial en que la plataforma publicó el documento, si la informa.
  fechaCarga         DateTime?       @map("fecha_carga") @db.Date
  /// URL o referencia del documento en la plataforma de origen.
  urlOrigen          String?         @map("url_origen")
  estado             EstadoDocumento @default(PENDIENTE)
  /// Tipo MIME real (validado al descargar), no el que declara la plataforma.
  tipoMime           String?         @map("tipo_mime") @db.VarChar(100)
  tamanoBytes        Int?            @map("tamano_bytes")
  sha256             String?         @db.Char(64)
  rutaAlmacenamiento String?         @map("ruta_almacenamiento")
  descargadoEn       DateTime?       @map("descargado_en") @db.Timestamptz(3)
  /// Quién lo subió a mano (p. ej. un documento que la plataforma solo entrega tras un reto). Nulo
  /// si lo descargó LURIS de la plataforma.
  subidoPorId        String?         @map("subido_por_id") @db.Uuid
  /// Intentos de descarga y el último (para reintentar los no disponibles más tarde).
  intentos           Int             @default(0)
  ultimoIntentoEn    DateTime?       @map("ultimo_intento_en") @db.Timestamptz(3)
  creadoEn           DateTime        @default(now()) @map("creado_en") @db.Timestamptz(3)

  actuacion Actuacion  @relation(fields: [actuacionId, despachoId], references: [id, despachoId], onDelete: Cascade)
  subidoPor Membresia? @relation(fields: [subidoPorId, despachoId], references: [id, despachoId], onDelete: NoAction)

  @@unique([actuacionId, idExterno])
  @@index([despachoId, sha256])
  @@map("documentos")
}

/**
 * Bandeja «Pendientes de tu confirmación» (§6): consultas en plataformas con reto (CAPTCHA) que
 * LURIS no hace sola y esperan que una persona las confirme. A lo sumo una abierta por proceso y
 * plataforma.
 */
model PendienteDeConfirmacion {
  id         String           @id @default(uuid(7)) @db.Uuid
  despachoId String           @map("despacho_id") @db.Uuid
  procesoId  String           @map("proceso_id") @db.Uuid
  plataforma CodigoPlataforma
  origen     OrigenPendiente
  creadoEn   DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  /// Cuándo se guardó la consulta que lo resolvió. Nulo = sigue pendiente.
  resueltoEn DateTime?        @map("resuelto_en") @db.Timestamptz(3)

  despacho Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  proceso  Proceso  @relation(fields: [procesoId, despachoId], references: [id, despachoId], onDelete: Cascade)

  @@unique([procesoId, plataforma], map: "pendientes_uno_abierto", where: raw("resuelto_en IS NULL"))
  @@index([despachoId, resueltoEn])
  @@map("pendientes_de_confirmacion")
}

// ─── Credenciales de plataformas ──────────────────────────────────────────────

/// Usuario y secreto para plataformas con login. El secreto se guarda cifrado (AES-256-GCM) y
/// nunca se registra en logs ni se devuelve al cliente.
model CredencialPlataforma {
  id                 String            @id @default(uuid(7)) @db.Uuid
  despachoId         String            @map("despacho_id") @db.Uuid
  /// Quién la registró y dio el consentimiento; para alcance PERSONAL, también su dueño.
  membresiaId        String            @map("membresia_id") @db.Uuid
  plataforma         CodigoPlataforma
  alcance            AlcanceCredencial
  usuario            String            @db.VarChar(200)
  secretoCifrado     Bytes             @map("secreto_cifrado")
  /// Versión de la clave de cifrado usada, para poder rotarla.
  versionClave       Int               @default(1) @map("version_clave")
  /// Consentimiento explícito al registrarla (§6).
  consentimientoEn   DateTime          @map("consentimiento_en") @db.Timestamptz(3)
  /// Última vez que LURIS probó el acceso con ella, y cómo le fue (mismos códigos que las consultas).
  verificadaEn       DateTime?         @map("verificada_en") @db.Timestamptz(3)
  estadoVerificacion EstadoConsulta?   @map("estado_verificacion")
  /// Sesión de la plataforma (cookies) cifrada con la clave de credenciales, para reutilizarla en
  /// vez de ingresar en cada consulta (§6). Se borra al cambiar la credencial.
  sesionCifrada      Bytes?            @map("sesion_cifrada")
  sesionVersionClave Int?              @map("sesion_version_clave")
  sesionGuardadaEn   DateTime?         @map("sesion_guardada_en") @db.Timestamptz(3)
  /// Cuándo la plataforma pidió un código de acceso (segundo factor) que la persona debe escribir.
  codigoSolicitadoEn DateTime?         @map("codigo_solicitado_en") @db.Timestamptz(3)
  creadoEn           DateTime          @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn      DateTime          @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  membresia Membresia @relation(fields: [membresiaId, despachoId], references: [id, despachoId], onDelete: Cascade)

  @@unique([despachoId, plataforma], map: "credenciales_una_por_despacho", where: raw("alcance = 'DESPACHO'"))
  @@unique([membresiaId, plataforma], map: "credenciales_una_personal", where: raw("alcance = 'PERSONAL'"))
  @@index([despachoId, plataforma])
  @@map("credenciales_plataforma")
}

// ─── Consulta masiva ──────────────────────────────────────────────────────────

model ConsultaMasiva {
  id            String               @id @default(uuid(7)) @db.Uuid
  despachoId    String               @map("despacho_id") @db.Uuid
  creadaPorId   String               @map("creada_por_id") @db.Uuid
  estado        EstadoConsultaMasiva @default(PENDIENTE)
  /// Entre 1 y 400 (CHECK).
  totalItems    Int                  @map("total_items")
  iniciadaEn    DateTime?            @map("iniciada_en") @db.Timestamptz(3)
  finalizadaEn  DateTime?            @map("finalizada_en") @db.Timestamptz(3)
  /// Cuándo se avisó a quien la hizo que terminó (§7). Nulo = aún no se le avisa.
  notificadaEn  DateTime?            @map("notificada_en") @db.Timestamptz(3)
  creadoEn      DateTime             @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime             @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  creadaPor Membresia            @relation(fields: [creadaPorId, despachoId], references: [id, despachoId], onDelete: Cascade)
  items     ItemConsultaMasiva[]

  @@unique([id, despachoId])
  @@index([despachoId, creadoEn(sort: Desc)])
  @@map("consultas_masivas")
}

/// Un ítem por (identificador × plataforma).
model ItemConsultaMasiva {
  id                String                   @id @default(uuid(7)) @db.Uuid
  despachoId        String                   @map("despacho_id") @db.Uuid
  consultaMasivaId  String                   @map("consulta_masiva_id") @db.Uuid
  tipoIdentificador TipoIdentificador        @map("tipo_identificador")
  /// Radicado (23) o NUNC (21) normalizado, según tipoIdentificador (CHECK).
  identificador     String                   @db.VarChar(23)
  /// El proceso del despacho que se consulta (el que ya existía o el que la consulta registró).
  procesoId         String?                  @map("proceso_id") @db.Uuid
  plataforma        CodigoPlataforma
  estado            EstadoItemConsultaMasiva @default(PENDIENTE)
  resultado         EstadoConsulta?
  intentos          Int                      @default(0)
  /// Resumen del resultado (p. ej. cantidad de actuaciones nuevas). Sin datos técnicos.
  resumen           Json?
  creadoEn          DateTime                 @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime                 @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  consultaMasiva ConsultaMasiva @relation(fields: [consultaMasivaId, despachoId], references: [id, despachoId], onDelete: Cascade)
  proceso        Proceso?       @relation(fields: [procesoId, despachoId], references: [id, despachoId], onDelete: Cascade)

  @@unique([consultaMasivaId, identificador, plataforma])
  @@index([consultaMasivaId, estado])
  @@index([despachoId, procesoId, plataforma, estado])
  @@map("items_consulta_masiva")
}

// ─── Notificaciones ───────────────────────────────────────────────────────────

/// Preferencias de notificación de una persona en un despacho.
model PreferenciaNotificacion {
  id                       String                 @id @default(uuid(7)) @db.Uuid
  despachoId               String                 @map("despacho_id") @db.Uuid
  membresiaId              String                 @map("membresia_id") @db.Uuid
  correoActivo             Boolean                @default(true) @map("correo_activo")
  /// Solo puede activarse con número y consentimiento registrados (CHECK).
  whatsappActivo           Boolean                @default(false) @map("whatsapp_activo")
  /// Formato internacional, solo dígitos (p. ej. 573001234567).
  numeroWhatsapp           String?                @map("numero_whatsapp") @db.VarChar(15)
  consentimientoWhatsappEn DateTime?              @map("consentimiento_whatsapp_en") @db.Timestamptz(3)
  frecuencia               FrecuenciaNotificacion @default(INMEDIATA)
  creadoEn                 DateTime               @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn            DateTime               @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  membresia Membresia @relation(fields: [membresiaId, despachoId], references: [id, despachoId], onDelete: Cascade)

  @@unique([membresiaId, despachoId])
  @@map("preferencias_notificacion")
}

/// Registro de envíos. La clave única garantiza la idempotencia: nunca se envía dos veces la
/// misma actuación a la misma persona por el mismo canal.
model Notificacion {
  id             String             @id @default(uuid(7)) @db.Uuid
  despachoId     String             @map("despacho_id") @db.Uuid
  membresiaId    String             @map("membresia_id") @db.Uuid
  actuacionId    String             @map("actuacion_id") @db.Uuid
  canal          CanalNotificacion
  estado         EstadoNotificacion @default(PENDIENTE)
  intentos       Int                @default(0)
  /// Código técnico del último fallo, para operación. No se muestra al usuario.
  codigoError    String?            @map("codigo_error") @db.VarChar(100)
  programadaPara DateTime           @default(now()) @map("programada_para") @db.Timestamptz(3)
  enviadaEn      DateTime?          @map("enviada_en") @db.Timestamptz(3)
  creadoEn       DateTime           @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime           @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  destinatario Membresia @relation(fields: [membresiaId, despachoId], references: [id, despachoId], onDelete: Cascade)
  actuacion    Actuacion @relation(fields: [actuacionId, despachoId], references: [id, despachoId], onDelete: Cascade)

  @@unique([actuacionId, membresiaId, canal])
  @@index([estado, programadaPara])
  @@index([membresiaId])
  @@map("notificaciones")
}

/// Sesión de WhatsApp del despacho (§9): un número dedicado vinculado por QR. Las credenciales y
/// las claves de Baileys se guardan cifradas (AES-256-GCM) y nunca se registran en logs.
model SesionWhatsapp {
  id                      String               @id @default(uuid(7)) @db.Uuid
  despachoId              String               @unique @map("despacho_id") @db.Uuid
  estado                  EstadoSesionWhatsapp @default(SIN_VINCULAR)
  /// Credenciales y claves de Signal en JSON cifrado. Nulo si no hay vinculación.
  datosCifrados           Bytes?               @map("datos_cifrados")
  versionClave            Int?                 @map("version_clave")
  /// QR vigente, cifrado: quien lo escanee vincula su WhatsApp a LURIS.
  qrCifrado               Bytes?               @map("qr_cifrado")
  qrVersionClave          Int?                 @map("qr_version_clave")
  qrGeneradoEn            DateTime?            @map("qr_generado_en") @db.Timestamptz(3)
  /// Número vinculado (solo dígitos, formato internacional).
  numero                  String?              @db.VarChar(15)
  /// El administrador pidió vincular; el worker lo atiende y lo limpia.
  vinculacionSolicitadaEn DateTime?            @map("vinculacion_solicitada_en") @db.Timestamptz(3)
  conectadaEn             DateTime?            @map("conectada_en") @db.Timestamptz(3)
  creadoEn                DateTime             @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn           DateTime             @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  despacho Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)

  @@map("sesiones_whatsapp")
}

// ─── Auditoría ────────────────────────────────────────────────────────────────

/// Quién hizo qué y cuándo. Solo se agregan registros (nunca se editan ni se borran desde la app).
model RegistroAuditoria {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Nulo para acciones de plataforma (superadmin) que no pertenecen a un despacho.
  despachoId String?  @map("despacho_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  accion     String   @db.VarChar(100)
  entidad    String?  @db.VarChar(100)
  entidadId  String?  @map("entidad_id") @db.VarChar(100)
  /// Detalle de la acción. Nunca credenciales, tokens ni contenido de documentos.
  datos      Json?
  ip         String?  @db.VarChar(45)
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  despacho Despacho? @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  actor    Usuario?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([despachoId, creadoEn(sort: Desc)])
  @@index([actorId])
  @@map("registros_auditoria")
}
